# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# Used for the real Jev (TypeSafe AI "System One") API calls throughout the
# course. Jev is in early access as of Sept 2026 — request access at
# https://typesafe.ai/ or via console.typesafe.ai.
TYPESAFE_API_KEY=

# --- The "generative LLM" half of the course (drafting text) -----------------
#
# This project uses LiteLLM, so it works with almost any provider — pick ONE
# of the sections below, set CHAT_MODEL to match, and fill in that provider's
# key. See README "Bring Your Own Model" for a free-key walkthrough per
# provider.

# CHAT_MODEL is any LiteLLM model string. Defaults to gpt-4o-mini if unset.
CHAT_MODEL=gpt-4o-mini

# OpenAI (CHAT_MODEL=gpt-4o-mini) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (CHAT_MODEL=claude-haiku-4-5-20251001) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Google AI Studio, free tier (CHAT_MODEL=gemini/gemini-2.5-flash) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq, free tier (CHAT_MODEL=groq/<model-name-from-console.groq.com>) — https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter, some free-tagged models (CHAT_MODEL=openrouter/<model>) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Ollama — no API key in .env at all either way, but two flavors:
#
# 1. Fully local (your machine does the work, no signup):
#    Install from https://ollama.com, `ollama pull llama3.2`, then
#    CHAT_MODEL=ollama_chat/llama3.2
#
# 2. Ollama Cloud (free hosted models, no local hardware needed — includes
#    Gemma 4): install Ollama, run `ollama signin` once (no card required),
#    `ollama pull gemma4:31b-cloud`, then
#    CHAT_MODEL=ollama_chat/gemma4:31b-cloud
#    Your local `ollama` daemon transparently proxies any "-cloud" model to
#    Ollama's hosted service after sign-in — verified working end to end.
